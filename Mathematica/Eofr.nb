         Pattern[Private`model, 
          Blank[]], 
         Pattern[Private`nperrun, 
          Blank[]], 
         Pattern[Private`nruns, 
          Blank[]], 
         Pattern[Private`massamu, 
          Blank[]], 
         Pattern[Private`vx, 
          Blank[]], 
         Pattern[Private`vy, 
          Blank[]], 
         Pattern[Private`vz, 
          Blank[]], 
         Pattern[Private`numberdensity, 
          Blank[]], 
         Pattern[Private`tpara, 
          Blank[]], 
         Pattern[Private`tperp, 
          Blank[]], 
         Pattern[Private`opts, 
          OptionsPattern[]]] :> 
       Module[{Private`results, Private`image, Private`maxcij, 
          Private`numberflux, Private`scalefactor, Private`numbertraced, 
          Private`numberdetected, Private`rv, Private`rtheta, Private`rphi, 
          Private`ralpha, Private`nflux, Private`ntrace, Private`sf, 
          Private`ntraced, Private`landingpositions, Private`modelopts, 
          Private`scale, Private`z0, Private`z1, Private`dz, Private`rSkin, 
          Private`countratescale, Private`boomangle, Private`aperlim, 
          Private`tauccd, Private`innerdomebias, Private`sensorbias, 
          Private`detectorresolution, Private`pixelwidth, Private`xc, 
          Private`yc, Private`phic}, 
         Private`modelopts = Options[Private`model]; 
         Private`scale = ReplaceAll["scale", Private`modelopts]; Switch[
           SymbolName[Private`model], 
           Alternatives["siiModel", "seiModel"], 
           Private`z0 = 
            Private`scale 
             ReplaceAll["rOuter" Sin["thetaOuterLow"], Private`modelopts]; 
           Private`z1 = 
            Private`z0 + 
             Private`scale ReplaceAll["apertureThickness", Private`modelopts],
            "cefiModel", 
           Private`z0 = Private`scale ReplaceAll["zSkin0", Private`modelopts]; 
           Private`z1 = 
            Private`scale ReplaceAll["zSkin1", Private`modelopts]]; 
         Private`dz = Private`z1 - Private`z0; 
         Private`rSkin = ReplaceAll[Private`scale "rSkin", Private`modelopts]; 
         Private`boomangle = OptionValue["BoomAngle"]; 
         Private`aperlim = OptionValue["ApertureAngularLimit"]; 
         Private`tauccd = OptionValue["IntegrationPeriod"]; 
         Private`innerdomebias = ReplaceAll[
            OptionValue["InnerDomeBias"], Automatic -> 
            ReplaceAll["vInnerDome" - "vOuterDome", Private`modelopts]]; 
         Private`sensorbias = OptionValue["SensorBias"]; 
         Private`detectorresolution = OptionValue["DetectorResolution"]; 
         Private`pixelwidth = OptionValue["PixelWidth"]; 
         Private`xc = ReplaceAll[
            OptionValue["ImageCenterX"], 
            Automatic -> (Private`detectorresolution + 1)/2.]; 
         Private`yc = ReplaceAll[
            OptionValue["ImageCenterY"], 
            Automatic -> (Private`detectorresolution + 1)/2.]; 
         Private`phic = OptionValue["ImageRotation"]; 
         Private`results = 
          Map[({Private`rv, Private`rtheta, Private`rphi, Private`ralpha, 
               Private`nflux, Private`ntrace, Private`sf} = 
             XTracer`randomV[
              Private`nperrun, Private`massamu, -Private`vx, Private`vy, 
               Private`vz, Private`numberdensity, Private`tpara, 
               Private`tperp, Private`boomangle, Private`aperlim, 
               XTracer`area[Private`rSkin, Private`dz], Private`tauccd]; 
            Private`ntraced = Length[Private`rv]; 
            Private`landingpositions = 
             XTracer`traceParticles[
              Private`model, Private`rv, Private`rtheta, Private`rphi, 
               Private`ralpha, Private`massamu, Private`innerdomebias, 
               Private`sensorbias, 
               FilterRules[{Private`opts}, 
                Options[XTracer`traceParticles]]]; {Private`ntraced, 
              XTracer`siiFootPrint[
              Private`landingpositions, Private`detectorresolution, 
               Private`pixelwidth, Private`xc, Private`yc, Private`phic, 
               FilterRules[{Private`opts}, 
                Options[XTracer`siiFootPrint]]]})& , 
            Range[Private`nruns]]; 
         Private`scalefactor = Private`sf/Private`nruns; 
         Private`countratescale = 
          If[OptionValue["ScaleCountRate"] === True, 
            OptionValue["TransmissionFactor"] Private`scalefactor, 1]; 
         Private`image = Private`countratescale Total[
             Part[Private`results, All, 2], {1}]; 
         Private`maxcij = Apply[Max, Private`image]; 
         Private`numberflux = Private`countratescale (Private`nflux/10000); 
         Private`numberdetected = Total[Private`image, Infinity]; 
         Private`numbertraced = Total[
            Part[Private`results, All, 1]]; {
          Private`image, Private`maxcij, Private`numberflux, 
           Private`numberdetected, Private`scalefactor, 
           Private`numbertraced}]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     "ScaleCountRate" -> True, "TransmissionFactor" -> 1, "BoomAngle" -> 0., 
      "ApertureAngularLimit" -> 90., "IntegrationPeriod" -> 0.06, 
      "InnerDomeBias" -> Automatic, "SensorBias" -> 0., "DetectorResolution" -> 
      64, "PixelWidth" -> 0.0003556, "ImageCenterX" -> Automatic, 
      "ImageCenterY" -> Automatic, "ImageRotation" -> 0., "BiasFactor" -> 1, 
      "MagneticField" -> {0., 0., 0.}, "TiiImage" -> True}, 
    "Attributes" -> {}, "FullName" -> "XTracer`runSimulation"|>, 
   False]]], "Output",
 CellChangeTimes->{3.820673152038905*^9, 3.888316759486744*^9, 
  3.888316814194553*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"7f7bcc65-7ef2-4e90-9411-97184543f2a4"]
